{
  "name": "natcut",
  "version": "0.1.0",
  "private": true,
  "description": "Local read-only bridge for the Liene PixCut S1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "predev:lan": "node scripts/check-node.mjs",
    "pretest": "node scripts/check-node.mjs",
    "pretypecheck": "node scripts/check-node.mjs",
    "prestart": "node scripts/check-node.mjs",
    "prestatus": "node scripts/check-node.mjs",
    "preemulators:test": "node scripts/check-node.mjs",
    "pretest:e2e": "node scripts/check-node.mjs",
    "start": "node src/server.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "build:hosting": "npm run build --workspace @natcut/visitor",
    "deploy:hosting": "node scripts/deploy-hosting.mjs",
    "verify:indexes": "node scripts/verify-natcut-indexes.mjs",
    "smoke:storage": "node scripts/cloud-storage-smoke.mjs",
    "smoke:submission": "tsx scripts/cloud-submission-smoke.ts",
    "worker:cloud:sim": "tsx scripts/cloud-worker.ts",
    "worker:cloud:smoke": "tsx scripts/cloud-worker-smoke.ts",
    "proof:sheet": "tsx scripts/proof-sheet.ts",
    "physical:dry-run": "tsx scripts/physical-dry-run.ts",
    "test": "npm run test:legacy && npm run test:unit",
    "test:e2e": "playwright test",
    "test:legacy": "node --test test/protocol.test.mjs test/server.test.mjs test/snapshot.test.mjs test/usb-session.test.mjs",
    "test:unit": "node --import tsx --test test/workspace-smoke.test.mjs test/cloud-worker-entrypoint.test.mjs test/cloud-boundaries.test.mjs test/cloud-storage-smoke.test.mjs test/cloud-submission-smoke.test.mjs test/dev-config.test.mjs test/physical-dry-run.test.mjs test/proof-sheet.test.mjs test/sprite-review.test.mjs test/natcut-indexes.test.mjs && vitest run --passWithNoTests",
    "emulators:test": "node scripts/emulators-test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "status": "node bin/status.mjs",
    "sprites:import": "node scripts/import-sprites.mjs",
    "sprites:review": "node scripts/sprite-review.ts"
  },
  "dependencies": {
    "usb": "^2.14.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "15.37.0",
    "jsdom": "^27.2.0",
    "qrcode-terminal": "0.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "license": "MIT"
}
